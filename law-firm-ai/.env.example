# Database
DATABASE_URL="postgresql://lawfirm:lawfirm@localhost:5432/lawfirm?schema=public"

# Redis (BullMQ)
REDIS_URL="redis://localhost:6379"

# Ollama
OLLAMA_URL="http://localhost:11434"
OLLAMA_API_BASE="http://localhost:11434/v1"
OLLAMA_NUM_PARALLEL=4
OLLAMA_KEEP_ALIVE="30m"
OLLAMA_MAX_LOADED_MODELS=2

# Models
LLM_MAIN_MODEL="qwen3.6:32b-instruct-q4_K_M"
LLM_MAIN_FALLBACK="qwen3.6:14b"
LLM_HELPER_MODEL="gemma4:9b"
EMBEDDING_MODEL="multilingual-e5-large"
EMBEDDING_DIM=1024
RERANK_MODEL="ms-marco-MiniLM-L-6-v2"

# Context window
LLM_NUM_CTX=32768

# PII service
PII_SERVICE_URL="http://localhost:5001"
PII_PRESIDIO_THRESHOLD=0.6

# Auth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="change-me-to-a-random-32-byte-hex"

# Storage
STORAGE_ROOT="./storage"

# App
NODE_ENV="development"
APP_BASE_URL="http://localhost:3000"
LAW_FIRM_NAME="Demo Hukuk Bürosu"
LAW_FIRM_ADDRESS="İstanbul, Türkiye"
LAW_FIRM_TAX_ID="1234567890"

# Scraper
SCRAPER_USER_AGENT_ROTATE=true
SCRAPER_RATE_LIMIT_MS=3000
