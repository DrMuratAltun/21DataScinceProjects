FROM python:3.11-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl \
    && rm -rf /var/lib/apt/lists/*

COPY services/pii-service/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Türkçe spaCy modeli. trf büyük (~500 MB) — küçük ortamlarda sm kullanın.
RUN python -m spacy download tr_core_news_sm || true \
    && (python -m spacy download tr_core_news_trf || true)

COPY services/pii-service/ ./

EXPOSE 5001
CMD ["uvicorn", "app:app", "--host", "0.0.0.0", "--port", "5001"]
